# =====================================================================================
#  IronPulse configuration.  Copy to .env (setup scripts do this and fill the secrets).
#  Every value here can also be set as a real environment variable.
# =====================================================================================

# ---------------------------------------------------------------- app
APP_NAME=IronPulse
ENVIRONMENT=development            # development | production | test  (production: README "Deploying to production")
DEBUG=false
HOST=127.0.0.1                     # 0.0.0.0 to serve other devices on your LAN
PORT=10000                         # the web app port (change freely)
PUBLIC_BASE_URL=http://localhost:10000
# ALLOWED_HOSTS: Host names the app answers. Unset = localhost,127.0.0.1,::1 (this machine; add your LAN IP to use
# HOST=0.0.0.0). ENVIRONMENT=production needs it set to the site's host name(s) - bare names, no https:// or :port.
# ALLOWED_HOSTS=gym.example.com
CORS_ORIGINS=                      # comma separated extra origins; empty = same-origin only
# COOKIE_SECURE, FORCE_HTTPS and TRUST_PROXY_HEADERS: unset = false in development and TRUE with ENVIRONMENT=production.
# Set one only to override it; an explicit false in production is honoured but logged as a warning at every start.
# COOKIE_SECURE=true               # Secure + __Host- cookies and HSTS (the site is served over HTTPS)
# FORCE_HTTPS=true                 # plain http -> 308 to https, HSTS
# TRUST_PROXY_HEADERS=true         # X-Forwarded-For / -Proto, believed only from TRUSTED_PROXIES
TRUSTED_PROXIES=127.0.0.1,::1      # your reverse proxies (IPs or CIDR); X-Forwarded-For is ignored from anyone else

# ---------------------------------------------------------------- secrets (setup generates these)
SECRET_KEY=change-me-run-setup-to-generate-a-64-char-secret
DATA_ENCRYPTION_KEY=               # Fernet key - encrypts ID-card scans & payout details at rest
ID_HASH_PEPPER=                    # pepper for hashing ID numbers (duplicate-ID fraud detection)

# ---------------------------------------------------------------- PostgreSQL + pgvector (async SQLAlchemy / asyncpg)
DATABASE_URL=postgresql+asyncpg://ironpulse:ironpulse@localhost:5432/ironpulse
DATABASE_ADMIN_URL=                # optional superuser URL, used only to CREATE DATABASE / EXTENSION
TEST_DATABASE_URL=postgresql+asyncpg://ironpulse:ironpulse@localhost:5432/ironpulse_test
# Connections PER WORKER PROCESS (+1 LISTEN with REALTIME_PG_BRIDGE): all workers together need
# workers x (DB_POOL_SIZE + DB_MAX_OVERFLOW + 1). The defaults fit 4 workers on a default PostgreSQL (64 of 97);
# every worker logs a WARNING at startup when they do not fit (ARCHITECTURE.md "Database sizing"). Defaults shown.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=5
# Server-side limits (ARCHITECTURE.md "Database limits"; 0 = the PostgreSQL default). Defaults shown - uncomment to change.
# A request statement that runs longer than this is cancelled and answered "taking too long" (503).
# DB_STATEMENT_TIMEOUT_MS=15000
# DB_IDLE_TX_TIMEOUT_MS=60000           # (ENVIRONMENT=test uses 1 h unless this is set)
# DB_POOL_TIMEOUT_S=10                  # wait for a free pooled connection, then 503
# DB_LONG_STATEMENT_TIMEOUT_MS=300000   # app.db.long_statement(): batch jobs, the CSV export
# DB_BACKGROUND_IDLE_TX_TIMEOUT_MS=600000

# ---------------------------------------------------------------- data retention (app/services/retention.py, nightly)
# Days to keep each kind of row (0 = keep for ever). Defaults shown - uncomment to change.
# RETENTION_SECURITY_DAYS=90            # security_events
# RETENTION_AUDIT_DAYS=365              # audit_logs
# RETENTION_AI_LOG_DAYS=30              # ai_call_logs
# RETENTION_EMAIL_DAYS=30               # e-mail already sent / logged / failed
# RETENTION_JOBS_DAYS=14                # finished background jobs
# RETENTION_NOTIFICATION_DAYS=90        # notifications already read (unread ones are kept)
# RETENTION_IP_BAN_DAYS=90              # IP bans lifted / expired this long ago (never an active ban; at least 30)
# RETENTION_AUTH_TOKEN_DAYS=30          # one-time links used / expired this long ago (an unused invite stays)
# RETENTION_SESSION_DAYS=30             # sign-in sessions expired this long ago
# RETENTION_HOUR_UTC=21                 # runs once a day from this UTC hour
# RETENTION_BATCH=1000                  # rows deleted per transaction
# RETENTION_MAX_SECONDS=600             # time budget per run; the next run continues

# ---------------------------------------------------------------- Redis (optional): fast shared session store
# Stores session -> user id; the latest name/e-mail/photo is always read from PostgreSQL. Empty = DB-only.
REDIS_URL=                         # e.g. redis://:password@127.0.0.1:6379/0  (docker compose: localhost:6380)
# REALTIME_PG_BRIDGE_URL=            # direct (session-pooled) DB URL for the cross-worker LISTEN bridge behind PgBouncer

# ---------------------------------------------------------------- AI providers - tried strictly in this order
AI_PROVIDER_ORDER=gateway,docker,anthropic
# 1) Gemma behind your OpenAI-compatible gateway (llama.cpp)
AI_GATEWAY_BASE_URL=http://192.168.0.101:8000/v1
AI_GATEWAY_API_KEY=change-me-gateway-key
AI_GATEWAY_MODEL=gemma
AI_GATEWAY_STATUS_URL=http://192.168.0.101:8000/status
# 2) Failsafe: Gemma in a local Docker container (docker/compose.yml -> Ollama). ./run.sh starts it in the background
#    (--no-ai-docker skips it); the app inside compose uses http://ollama:11434/v1 (README "Local fallback LLM")
AI_DOCKER_BASE_URL=http://localhost:11434/v1
AI_DOCKER_API_KEY=ollama
AI_DOCKER_MODEL=gemma3:4b
# AI_DOCKER_FIRST_TOKEN_SECONDS=25  # least time the local model gets for its first words in a streamed answer
# memory of the Ollama container (gemma3:4b needs ~4.5 GB; raise both for a bigger AI_DOCKER_MODEL)
# OLLAMA_MEMORY_LIMIT=6g
# OLLAMA_MEMORY_RESERVATION=4g
# 3) Last resort: Claude (Anthropic API key)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
# Load tests only: the simulated provider (local answers with realistic latency, no model) runs only when named in
# AI_PROVIDER_ORDER, e.g. AI_PROVIDER_ORDER=simulated - never by default. ENVIRONMENT=production also needs
# AI_SIMULATED_ALLOWED=true and then warns at every start. README "Deploying to production" -> "Load tests".
# AI_SIMULATED_ALLOWED=false
# AI_SIM_FIRST_TOKEN_MS=400..1500    # time to the first words, uniform (one number = fixed)
# AI_SIM_TOKENS_PER_S=25..60         # words per second, one rate per call
# AI_SIM_FAILURE_RATE=0              # 0..1: share of calls that fail like an unreachable server
# AI_SIM_MAX_CONCURRENCY=4           # provider slots, like AI_GATEWAY_MAX_CONCURRENCY
# AI_SIM_TTS=true                    # simulate the coach voice (Kokoro lane) too: silent MP3
# AI_SIM_TTS_MS=300..1200            # time to synthesise one voice line
# AI_SIM_ECHO_NONCE=false            # bug hunts: answers start with the nonces of the requester's own words
# AI_SIM_CAPTURE_PROMPTS=            # bug hunts: JSONL file every prompt is appended to (mode 0600)
# AI_SIM_CAPTURE_MAX_MB=256
# AI_CONNECT_TIMEOUT_SECONDS=2       # an AI provider must accept the connection within this, else the next is asked

# ---------------------------------------------------------------- OCR (several engines cross-validate ID cards)
TESSERACT_CMD=                     # auto-detected; e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_ENGINES=tesseract,apple_vision,windows_ocr,rapidocr,vision_llm
OCR_MIN_ENGINES=2

# ---------------------------------------------------------------- maps (Geoapify)
GEOAPIFY_API_KEY=                  # https://myprojects.geoapify.com  (empty -> OpenStreetMap fallback)

# ---------------------------------------------------------------- payments: Cashfree (empty keys -> clearly-labelled TEST MODE)
CASHFREE_ENV=sandbox               # sandbox | production
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_PAYOUT_CLIENT_ID=
CASHFREE_PAYOUT_CLIENT_SECRET=

# ---------------------------------------------------------------- e-mail (SMTP). Empty host -> mails are written to var/mail/
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=IronPulse <no-reply@ironpulse.local>
SMTP_STARTTLS=true
SMTP_SSL=false

# ---------------------------------------------------------------- security limits
# RATE_LIMIT_* are per network address, and a whole gym behind one NAT shares one address. Per-user AI quotas (and
# the duplicate / spam / cooldown rules) now live in app/ai/policy.py: the AI guard applies them to each member.
RATE_LIMIT_PER_MINUTE=240
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=60        # AI endpoints per address (per-user AI quotas: app/ai/policy.py)
RATE_LIMIT_LIVE_PER_MINUTE=120     # live workouts: progress events, commands, chat messages + coach voice
RATE_LIMIT_WHITELIST=              # IPs exempt from rate limiting (e.g. 127.0.0.1 for stress tests)
MAX_UPLOAD_MB=8
# Per-person caps (README "Limits" lists every limit). Defaults shown - uncomment to change.
# TASKS_MAX_OPEN=500                 # open tasks and reminders one person may hold (the task form and the assistant say so)
# TRAINER_MAX_CLIENTS=150            # active clients per trainer for automatic assignment (all full: member joins unassigned)
# MAX_ONLINE_GYMS=3                  # gyms one person may join on online or combo plans at once
# MAX_OFFLINE_GYMS=1                 # gyms one person may join in person (gym or combo plans) at once
# CAPS_OVERRIDES=                    # any other cap of app/core/caps.py, e.g. branches_per_gym=300,products_per_gym=5000
# RATE_LIMIT_REDIS_TIMEOUT_MS=250    # a shared-limit Redis call slower than this is judged from the worker's memory
# Sign-in sessions: a new sign-in ends the account's other sessions (the other device is told why). Default shown.
# SINGLE_SESSION_PER_ACCOUNT=true    # false = an account may stay signed in on several devices at once

# ---------------------------------------------------------------- trust & safety (app/services/trust_safety.py)
# Staff removed for a conduct violation by this many DIFFERENT gym owners within the window are banned automatically
# (a severe violation bans at once). Defaults shown - uncomment to change.
# VIOLATION_AUTOBAN_THRESHOLD=2
# VIOLATION_WINDOW_DAYS=365
# SEVERE_IP_BAN_DAYS=30              # a severe violation also bans the account's recent public addresses this long
# SHARED_IP_THRESHOLD=3              # ... except an address more than this many other active accounts used (flagged)

# ---------------------------------------------------------------- platform admin (super-admin): /superadmin/login only
# The platform admin signs in ONLY at /superadmin/login with these credentials. A changed SUPERADMIN_PASSWORD applies at
# the next start (every admin session is signed out); it is never logged or shown.
SUPERADMIN_EMAIL=admin@ironpulse.local
SUPERADMIN_PASSWORD=               # setup generates one
# Addresses / CIDR ranges allowed to open /superadmin/login and the admin console (empty = any address).
# SUPERADMIN_ALLOWED_IPS=203.0.113.7,10.0.0.0/8
# Failed admin sign-ins from one address within the window ban it (loopback 127.0.0.1 / ::1 is never banned; lift a ban
# from the server with: python scripts/manage.py unban <ip>). Defaults shown - uncomment to change.
# SUPERADMIN_LOGIN_MAX_FAILURES=5
# SUPERADMIN_LOGIN_WINDOW_MINUTES=15
# SUPERADMIN_LOGIN_BAN_HOURS=24

# ---------------------------------------------------------------- platform governance (app/services/governance.py)
# A gym scheduled for deletion stays suspended and restorable this long before the final deletion; destructive
# governance actions (bans, deletions, refunds, payouts) one admin may run per hour. Defaults shown.
# GYM_DELETE_COOLING_OFF_DAYS=7
# GOVERNANCE_ACTIONS_PER_HOUR=30

# ---------------------------------------------------------------- misc
RUN_BACKGROUND_JOBS=true
SEED_DEMO_DATA=true
RELOAD=false                       # true = auto-restart on code changes (development)
